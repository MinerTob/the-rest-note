---
import type { Lang } from '@/i18n/ui';
import { SITE } from '@/lib/site';
import type { RoutePair } from '@/lib/routes';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  routes?: RoutePair;
  rssHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  lang,
  title,
  description = '',
  routes,
  rssHref,
  ogType = 'website',
  publishedTime,
  updatedTime,
} = Astro.props;

const siteName = SITE.name;
const tagline = { zh: '个人数字空间', en: 'Personal digital space' }[lang];
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tagline}`;

const fallbackOrigin = new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, Astro.site ?? fallbackOrigin);
const pairs = routes ?? { zh: Astro.url.pathname, en: Astro.url.pathname };

function absolute(path: string): string {
  return new URL(path, Astro.site ?? fallbackOrigin).href;
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/*
  首页 Journey hash 的早期清理（客户端兜底）—— **必须在这里、同步执行**。
  ------------------------------------------------------------------
  "NEW VISIT 不许直接落在子页面、要先进对应语言的首页"这件事，现在**由服务端网关负责**：
  `server/entry-router.ts` 在"还没进过门"时把子路由 302 到 `/` 或 `/en/`，并顺手把
  `rest_note_entered` 记在这一趟的 cookie 里。这里**不再**做 `location.replace(target)` ——
  同一件事留两套实现迟早漂移。

  但有一件事服务端做不到，必须留在客户端：**#fragment 根本不会发给服务器**。所以
  `/#about`、`/en/#blog` 这种"首页 + Journey hash"在服务器那边看起来只是 `/`；而浏览器会
  在解析到对应 section id 时自己按 hash 定位一次（那一下会把关于区 observer、夜曲、
  身份物理都带起来）。所以 NEW VISIT 时要在 <head> 里同步把 hash 抹掉：不等
  DOMContentLoaded / astro:page-load / requestAnimationFrame / app.ts 的 boot()。

  NEW/SAME 判定照抄 src/lib/visit.ts 的 visitBoundary() 语义（这里不能引模块代码，也不写存储）：
  没有 session token → NEW；navigate → NEW；reload → history.state.restNoteVisit ===
  session token 才算 SAME，否则 NEW；back_forward → SAME；拿不到 / 认不出 type → NEW。
  storage / history / performance 的读取都用 try/catch 包住。

  动作只剩一个：**在本语言首页上**把 #home / #blog / #lab / #about 这四个 Journey hash 从
  地址栏抹掉（`history.replaceState` 带 history.state 与现有 search，不动 pathname / search）。
  子页不碰、SAME VISIT 不碰、其它 hash 不碰；静态资源不经过 BaseHead.astro，不为它们写判断。
*/}
<script is:inline>
  (function () {
    var SESSION_KEY = 'rest-note.visit';
    var STATE_KEY = 'restNoteVisit';
    var JOURNEY_HASHES = ['#home', '#blog', '#lab', '#about'];

    /* ---- NEW / SAME：与 lib/visit.ts 的 visitBoundary() 逐条对应 ---- */
    var sessionToken = null;
    try {
      sessionToken = window.sessionStorage.getItem(SESSION_KEY);
    } catch (error) {
      /* 隐私模式 / 存储被禁：读不到就当没有 → 新的一趟 */
      sessionToken = null;
    }

    var entryToken = null;
    try {
      var state = window.history.state;
      if (state && typeof state === 'object') {
        var stamped = state[STATE_KEY];
        if (typeof stamped === 'string' && stamped.length > 0) entryToken = stamped;
      }
    } catch (error) {
      entryToken = null;
    }

    var navigation = 'unknown';
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      if (nav && (nav.type === 'navigate' || nav.type === 'reload' || nav.type === 'back_forward')) {
        navigation = nav.type;
      }
    } catch (error) {
      navigation = 'unknown';
    }

    var isNewVisit;
    if (!sessionToken) isNewVisit = true;
    else if (navigation === 'navigate') isNewVisit = true;
    else if (navigation === 'reload') isNewVisit = entryToken !== sessionToken;
    else if (navigation === 'back_forward') isNewVisit = false;
    else isNewVisit = true;

    /* SAME VISIT：刷新子页 / 站内导航 / 前进后退 / 语言切换都不许被动到。 */
    if (!isNewVisit) return;

    /*
     * 子路由的同一条规则（NEW VISIT → 本语言首页）已经由服务端网关在 HTTP 层做过：
     * server/entry-router.ts 里 pathname 第一段不是 `en` 的去 `/`，是 `en` 的去 `/en/`，
     * 所以这里没有 `location.replace` —— 客户端只留服务端看不见的那一半（首页的 #fragment）。
     *
     * 判"这一页是不是本语言的首页"用的是和网关同一条规矩：pathname 的第一个非空 segment。
     *   '/'、'/en'、'/en/' → 首页（可以碰 hash）
     *   '/blog/...'、'/en/blog/...'、'/about/intro/...' → 子页（这里什么都不做）
     */
    var parts = location.pathname.split('/').filter(Boolean);
    var isEnglish = parts[0] === 'en';
    var isLanguageHome = isEnglish ? parts.length === 1 : parts.length === 0;
    if (!isLanguageHome) return;

    /* 已经在首页：只清那四个 Journey hash，search 保留。 */
    if (!JOURNEY_HASHES.includes(location.hash)) return;
    try {
      window.history.replaceState(
        window.history.state,
        '',
        window.location.pathname + window.location.search,
      );
    } catch (error) {
      /* 极端环境（file:// / 沙盒 iframe）下 replaceState 会抛：留着 hash 也比炸掉 <head> 强 */
    }
  })();
</script>

{/* 在首次绘制之前把主题写到 <html> 上，避免切页/刷新时闪一下默认主题。 */}
<script is:inline>
  (function () {
    var theme = 'modern';
    try {
      var stored = window.localStorage.getItem('space.theme');
      if (stored === 'baroque' || stored === 'modern') theme = stored;
    } catch (error) {
      /* 隐私模式：用默认主题 */
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<link rel="alternate" hreflang="zh-CN" href={absolute(pairs.zh)} />
<link rel="alternate" hreflang="en" href={absolute(pairs.en)} />
<link rel="alternate" hreflang="x-default" href={absolute(pairs.zh)} />

{rssHref && <link rel="alternate" type="application/rss+xml" title={pageTitle} href={absolute(rssHref)} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<meta name="theme-color" content="#eef3f9" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
