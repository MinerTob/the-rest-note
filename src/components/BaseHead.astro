---
import type { Lang } from '@/i18n/ui';
import { SITE } from '@/lib/site';
import type { RoutePair } from '@/lib/routes';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  routes?: RoutePair;
  rssHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  lang,
  title,
  description = '',
  routes,
  rssHref,
  ogType = 'website',
  publishedTime,
  updatedTime,
} = Astro.props;

const siteName = SITE.name;
const tagline = { zh: '个人数字空间', en: 'Personal digital space' }[lang];
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tagline}`;

const fallbackOrigin = new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, Astro.site ?? fallbackOrigin);
const pairs = routes ?? { zh: Astro.url.pathname, en: Astro.url.pathname };

function absolute(path: string): string {
  return new URL(path, Astro.site ?? fallbackOrigin).href;
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/*
  NEW VISIT 的入口归一化 —— **必须在这里、同步执行**。
  ------------------------------------------------------------------
  语义（本人定的最终版）：**任何站内 HTML 页面的 NEW VISIT 都不许直接落在子页面**，
  一律先进对应语言的首页（中文 `/`、英文 `/en/`），在那里显示 Entry Gate；
  点过"进入空间"之后就停在首页，不再跳回原来的子页。

  为什么必须在 <head> 里同步做：
    · fragment（#home / #about 等）不会发给服务器，托管层做不了重定向 —— 只能在客户端处理；
    · 子页直链要在**正文 DOM 解析之前**就换掉，否则会先闪一下文章/关于页，而且浏览器可能已经
      按 URL 里的 hash 做过原生 fragment 定位（关于区 observer / 夜曲会被带起来）。
  所以这段脚本不等 DOMContentLoaded / astro:page-load / requestAnimationFrame / app.ts 的 boot()。

  NEW/SAME 判定照抄 src/lib/visit.ts 的 visitBoundary() 语义（这里不能引模块代码，也不写存储）：
  没有 session token → NEW；navigate → NEW；reload → history.state.restNoteVisit ===
  session token 才算 SAME，否则 NEW；back_forward → SAME；拿不到 / 认不出 type → NEW。
  storage / history / performance 的读取都用 try/catch 包住。

  动作只有两种：
    · pathname 不是本语言的首页 → `location.replace(target)`（replace 不留子页历史条目，
      query / hash 都不继承；不用 pushState、不把原 pathname 存起来准备"进入后跳回"）；
    · 已经在首页 → 只把 #home / #blog / #lab / #about 这四个 Journey hash 从地址栏抹掉
      （`history.replaceState` 带 history.state 与现有 search，不动 pathname / search）。

  SAME VISIT 一律早退，什么都不做：刷新子页、站内点击文章、About → Intro、返回、前进/后退、
  语言切换都继续留在原路由。静态资源（/_astro/、图片、favicon、sitemap、rss.xml、robots.txt）
  不经过 BaseHead.astro，所以这里不为它们写任何判断。
*/}
<script is:inline>
  (function () {
    var SESSION_KEY = 'rest-note.visit';
    var STATE_KEY = 'restNoteVisit';
    var JOURNEY_HASHES = ['#home', '#blog', '#lab', '#about'];

    /* ---- NEW / SAME：与 lib/visit.ts 的 visitBoundary() 逐条对应 ---- */
    var sessionToken = null;
    try {
      sessionToken = window.sessionStorage.getItem(SESSION_KEY);
    } catch (error) {
      /* 隐私模式 / 存储被禁：读不到就当没有 → 新的一趟 */
      sessionToken = null;
    }

    var entryToken = null;
    try {
      var state = window.history.state;
      if (state && typeof state === 'object') {
        var stamped = state[STATE_KEY];
        if (typeof stamped === 'string' && stamped.length > 0) entryToken = stamped;
      }
    } catch (error) {
      entryToken = null;
    }

    var navigation = 'unknown';
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      if (nav && (nav.type === 'navigate' || nav.type === 'reload' || nav.type === 'back_forward')) {
        navigation = nav.type;
      }
    } catch (error) {
      navigation = 'unknown';
    }

    var isNewVisit;
    if (!sessionToken) isNewVisit = true;
    else if (navigation === 'navigate') isNewVisit = true;
    else if (navigation === 'reload') isNewVisit = entryToken !== sessionToken;
    else if (navigation === 'back_forward') isNewVisit = false;
    else isNewVisit = true;

    /* SAME VISIT：刷新子页 / 站内导航 / 前进后退 / 语言切换都不许被赶走。 */
    if (!isNewVisit) return;

    /*
     * 本语言的 canonical 入口：按 pathname 的**第一个 segment** 判语言 ——
     * 只看第一个非空段是不是 'en'，所以 '/en'（无尾斜杠）、'/en/'、'/en/blog/...'、
     * '/en/about/intro/...' 全都算英文；'/'、'/blog/...'、'/about/...' 都算中文。
     *
     * 不要退回 "=== '/en/' || startsWith('/en/')" 那种写法，也不要再补第三个字符串条件：
     * '/en' 既不等于 '/en/' 也不 startsWith('/en/')，会被误判成中文入口（本人报的 bug）。
     * 段判断天然覆盖这三种写法，pathname 后面的部分怎么变都不影响语言。
     */
    var parts = location.pathname.split('/').filter(Boolean);
    var isEnglish = parts[0] === 'en';
    var target = isEnglish ? '/en/' : '/';

    /* 子页：直接 replace 到首页。不带 query、不带 hash，也不留子页的历史条目。 */
    if (location.pathname !== target) {
      location.replace(target);
      return;
    }

    /* 已经在首页：只清那四个 Journey hash，search 保留。 */
    if (!JOURNEY_HASHES.includes(location.hash)) return;
    try {
      window.history.replaceState(
        window.history.state,
        '',
        window.location.pathname + window.location.search,
      );
    } catch (error) {
      /* 极端环境（file:// / 沙盒 iframe）下 replaceState 会抛：留着 hash 也比炸掉 <head> 强 */
    }
  })();
</script>

{/* 在首次绘制之前把主题写到 <html> 上，避免切页/刷新时闪一下默认主题。 */}
<script is:inline>
  (function () {
    var theme = 'modern';
    try {
      var stored = window.localStorage.getItem('space.theme');
      if (stored === 'baroque' || stored === 'modern') theme = stored;
    } catch (error) {
      /* 隐私模式：用默认主题 */
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<link rel="alternate" hreflang="zh-CN" href={absolute(pairs.zh)} />
<link rel="alternate" hreflang="en" href={absolute(pairs.en)} />
<link rel="alternate" hreflang="x-default" href={absolute(pairs.zh)} />

{rssHref && <link rel="alternate" type="application/rss+xml" title={pageTitle} href={absolute(rssHref)} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<meta name="theme-color" content="#eef3f9" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
