---
import T from './T.astro';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="clock glass glass--liquid" data-clock>
  <div class="clock__head">
    <span class="label label--caps label--dim"><T k="clock.label" lang={lang} /></span>
    {/* 先显示浏览器时区，IP 定位成功后切换到访客时区与城市 */}
    <span class="clock__zone num" data-clock-zone></span>
  </div>

  <div class="clock__screen">
    {/* 占位用零宽空格而不是 `--:--:--`：视觉上完全空白，但保住这一行的行高，真实时间到达时不会跳一下 */}
    <span class="clock__time num" data-clock-time>&#8203;</span>
  </div>

  <div class="clock__foot">
    <span class="clock__date num" data-clock-date>&#8203;</span>
    <span class="clock__city num"></span>
  </div>
</div>

<style>
  .clock {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(16px, 2vw, 24px);
    border-radius: var(--device-radius);
    background-image: var(--device-surface);
  }

  .clock__head,
  .clock__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .clock__zone,
  .clock__date,
  .clock__city {
    font-size: var(--fs-2xs);
    letter-spacing: 0.05em;
    color: var(--ink-4);
  }

  /* 屏：不是一块深色砖，而是一层比周围更亮的内嵌玻璃 */
  .clock__screen {
    position: relative;
    overflow: hidden;
    padding: 23px 12px 25px;
    border-radius: var(--radius-s);
    background-image: var(--lcd-screen-bg);
    border: 1px solid var(--lcd-screen-line);
    box-shadow:
      inset 0 1px 0 var(--device-screen-glint),
      inset 0 -8px 16px -12px var(--lcd-screen-glow);
  }

  /* 极细的横向刷新纹 */
  .clock__screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      color-mix(in srgb, var(--lcd-screen-ink) 7%, transparent) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
    opacity: .2;
  }

  .clock__time {
    position: relative;
    z-index: 1;
    display: block;
    font-size: clamp(2rem, 3.7vw, 3.3rem);
    text-align: center;
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.055em;
    color: var(--lcd-screen-ink);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 18px var(--lcd-screen-glow);
  }

  /* 每秒一次、非常轻的刷新感 */
  .clock__time.is-tick {
    animation: lcd-refresh var(--dur-2) var(--ease);
  }

  @keyframes lcd-refresh {
    0% { opacity: 0.66; }
    100% { opacity: 1; }
  }

  @media (max-width: 520px) {
    .clock__time {
      font-size: clamp(1.9rem, 7.5vw, 2.8rem);
    }
  }
@media (prefers-reduced-motion: reduce) { .clock__time.is-tick { animation: none; } }
</style>
