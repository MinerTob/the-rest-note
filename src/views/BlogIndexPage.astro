---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Passthrough from '@/components/Passthrough.astro';
import T from '@/components/T.astro';
import NoteRow from '@/components/NoteRow.astro';
import { collectTags, getPosts } from '@/lib/content';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { RoutePair } from '@/lib/routes';

interface Props {
  lang: Lang;
  routes: RoutePair;
  currentTag?: string;
  embedded?: boolean;
}

const { lang, routes, currentTag, embedded = false } = Astro.props;
const Layout = embedded ? Passthrough : BaseLayout;
const t = useTranslations(lang);

const all = await getPosts(lang);
const posts = currentTag ? all.filter((post) => post.data.tags.includes(currentTag)) : all;
const tags = collectTags(all);

const groups = posts.reduce<{ year: number; posts: typeof posts }[]>((accumulator, post) => {
  const year = post.data.pubDate.getFullYear();
  const last = accumulator[accumulator.length - 1];
  if (last && last.year === year) {
    last.posts.push(post);
  } else {
    accumulator.push({ year, posts: [post] });
  }
  return accumulator;
}, []);

/**
 * 年份下面再按月份分一层（带篇数），年份本身是锚点：`/blog/#2026` 能直接跳进那一年。
 * 借的是 Dejavu's Blog 那种"年份 → 月份 → 条目"的三层结构；文章越堆越多时，
 * 这层几乎不增加视觉重量，但滚动时眼睛有落脚点（见 §10）。
 */
const monthFormat = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short' });
const months = groups.map((group) => {
  const byMonth = group.posts.reduce<{ month: number; posts: typeof posts }[]>((accumulator, post) => {
    const month = post.data.pubDate.getMonth();
    const last = accumulator[accumulator.length - 1];
    if (last && last.month === month) last.posts.push(post);
    else accumulator.push({ month, posts: [post] });
    return accumulator;
  }, []);
  return { year: group.year, count: group.posts.length, byMonth };
});
---

<Layout
  lang={lang}
  routes={routes}
  title={t('blog.title')}
  description={t('blog.intro')}
  rssHref={lang === 'zh' ? '/rss.xml' : '/en/rss.xml'}
>
  <div class="wrap page">
    <header class="page__head rise">
      <h1 class="page__title">BLOG</h1>
      <p class="lede"><T k="blog.intro" lang={lang} /></p>
    </header>

    {tags.length > 0 && (
      <nav class="tagbar rise rise--2" aria-label={t('blog.tags')}>
        <a class:list={['chip', !currentTag && 'is-active']} href={localizePath('/blog/', lang)}>
          <T k="blog.all" lang={lang} />
          <span class="tagbar__count num">{all.length}</span>
        </a>
        {tags.map((tag) => (
          <a
            class:list={['chip', currentTag === tag.tag && 'is-active']}
            href={localizePath(`/blog/tags/${encodeURIComponent(tag.tag)}/`, lang)}
          >
            {tag.tag}
            <span class="tagbar__count num">{tag.count}</span>
          </a>
        ))}
      </nav>
    )}

    {posts.length > 0 ? (
      <div class="archive rise rise--2">
        {months.map((group) => (
          <section class="archive__group" id={String(group.year)}>
            <p class="archive__year num">
              <a class="archive__yearLink" href={`#${group.year}`}>
                {group.year}
                <span class="archive__count num">{group.count}</span>
              </a>
            </p>
            <div class="archive__months">
              {group.byMonth.map((month) => (
                <div class="archive__month">
                  <p class="archive__monthLabel num">
                    {monthFormat.format(new Date(group.year, month.month, 1))}
                    <span class="archive__count num">{month.posts.length}</span>
                  </p>
                  <ul class="notelist">
                    {month.posts.map((post) => (
                      <NoteRow post={post} lang={lang} />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="muted"><T k="blog.empty" lang={lang} /></p>
    )}
  </div>
</Layout>

<style>
  .page {
    padding-block: clamp(28px, 4.6vw, 50px);
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3.4vw, 38px);
  }

  .page__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 60ch;
  }

  .page__title {
    margin: 0;
    font-size: var(--fs-xxl);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    /* 显式写出自己的颜色：Safari 不给"继承来的颜色变化"补间，
       靠继承的话切主题时这个标题会直接跳色（Chrome 正常）。见 §5.13 */
    color: var(--ink);
  }

  .tagbar {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tagbar__count {
    color: var(--ink-4);
    font-size: 0.95em;
  }

  .tagbar :global(a.chip.is-active) {
    color: var(--ink);
    border-color: var(--accent-soft);
    background-color: var(--accent-wash);
  }

  .archive {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3.6vw, 38px);
  }

  .archive__group {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr);
    gap: 20px;
    /* 年份锚点：顶栏是 sticky 的，跳过来时别被它盖住 */
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  .archive__year {
    margin: 0;
    padding-top: 14px;
    font-size: var(--fs-2xs);
    color: var(--ink-4);
  }

  /* 年份本身可点（就是它自己的锚点），所以数字用主色、带下划线提示 */
  .archive__yearLink {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
    color: var(--ink-3);
    transition: color var(--dur-1) var(--ease);
  }

  .archive__yearLink:hover {
    color: var(--accent-2);
  }

  /* 年份 / 月份的篇数：比正文小一号、更淡，只当读数 */
  .archive__count {
    font-size: 0.92em;
    color: var(--ink-4);
    opacity: 0.75;
  }

  .archive__months {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* 月份是"行内小标签"：一条细线 + 月份 + 篇数，不抢年份的主次 */
  .archive__monthLabel {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin: 0 0 2px;
    padding-top: 12px;
    font-size: var(--fs-2xs);
    letter-spacing: var(--track-mid);
    color: var(--ink-4);
    border-top: 1px solid var(--line-soft);
  }

  .archive__month:first-child .archive__monthLabel {
    padding-top: 14px;
    border-top-color: transparent;
  }

  .notelist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 720px) {
    .archive__group {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .archive__year {
      padding-top: 0;
    }
  }
</style>
