---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import gensokyo from '@/images/Gensokyo.png';
import { getPage } from '@/lib/content';
import { localizePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { RoutePair } from '@/lib/routes';

/**
 * 自我介绍长文（About 页第十个标签点开的那一页）。
 *
 * 文案在 `src/content/pages/intro.zh.md` / `intro.en.md`：
 * 用 `##` 表示本人标了分段线（⸻）的地方，标题在样式里"加大加粗"（见 .letter h2）。
 * 图片来自 `src/images/`，走 astro:assets 自动压缩 + srcset，别手写 <img>。
 */
interface Props { lang: Lang; routes: RoutePair }
const { lang, routes } = Astro.props;
const zh = lang === 'zh';
const entry = await getPage('intro', lang);
if (!entry) throw new Error(`Missing content: src/content/pages/intro.${lang}.md`);
const { Content } = await render(entry);
/**
 * 返回的目标是首页那串拼接页里的"关于"区（`/#about`），不是独立的 `/about/` 页。
 * 本人要求：从这一页回去要落在那个"整串页面"里的关于区上。
 */
const backHref = `${localizePath('/', lang)}#about`;
---

<BaseLayout
  lang={lang}
  routes={routes}
  title={entry.data.title}
  description={entry.data.description}
>
  {/* data-nocturne：这一页接着放 About 页的那首夜曲（见 src/scripts/nocturne.ts） */}
  <article class="letter-page wrap" data-nocturne>
    <a class="letter-page__back glass glass--thin glass--pill glass--live" href={backHref}>
      <span class="letter-page__back-arrow" aria-hidden="true">←</span>
      {zh ? '返回' : 'Back to About'}
    </a>

    <header class="letter-page__head">
      <p class="label">THE REST NOTE · {zh ? '自我介绍' : 'SELF-INTRODUCTION'}</p>
      <h1 class="letter-page__title">{entry.data.title}</h1>
    </header>

    <figure class="letter-page__figure">
      <Image
        src={gensokyo}
        alt={zh
          ? '一张滨海湾的插画：蓝天白云下，新加坡国旗在风中，远处是滨海湾金沙、摩天观景轮和城市天际线。'
          : 'An illustration of Marina Bay: a Singapore flag in the wind under a wide blue sky, with Marina Bay Sands, the Flyer and the skyline behind.'}
        widths={[480, 720, 1080]}
        sizes="(max-width: 720px) 92vw, 660px"
        loading="eager"
      />
    </figure>

    <div class="letter prose">
      <Content />
    </div>

    <p class="letter-page__back">
      <a class="more-link" href={backHref}>{zh ? '回到关于' : 'Back to About'}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .letter-page {
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: clamp(24px, 4vw, 46px) clamp(40px, 7vw, 84px);
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.6vw, 30px);
  }

  .letter-page__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* 左上角的返回：这一页是从 About 的第十个标签点进来的，得能原路回去 */
  .letter-page__back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 16px 8px 13px;
    color: var(--ink-2);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }

  .letter-page__back:hover {
    color: var(--ink);
    transform: translateX(-2px);
  }

  .letter-page__back-arrow {
    font-size: 14px;
    line-height: 1;
  }

  .letter-page__head .label {
    margin: 0;
  }

  .letter-page__title {
    margin: 0;
    font-size: clamp(1.9rem, 1.4rem + 1.9vw, 2.6rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.028em;
    /* 显式写出自己的颜色：Safari 不给"继承来的颜色变化"补间（见 §5.13） */
    color: var(--ink);
  }

  /* 图片：满栏、圆角、跟正文同一套阴影，不额外加边框。 */
  .letter-page__figure {
    margin: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-s);
  }

  .letter-page__figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 本人标了分段的地方 → 内容里的 ## 标题：只负责"加大加粗"。
     标题上方曾经画过一道短线（当作原文的 ⸻ 标记），本人要求删掉了，
     所以这里不要再加回任何装饰线。 */
  .letter :global(h2) {
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.05rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-top: 2.9em;
  }

  /* 长文里的单句成段是本人自己的停顿，行间距保持宽松一点。 */
  .letter :global(p) {
    line-height: var(--lh-loose);
  }

  .letter-page__back {
    margin: 0;
  }
</style>
