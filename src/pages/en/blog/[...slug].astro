---
import PostPage from '@/views/PostPage.astro';
import { postStaticPaths, type PostProps } from '@/lib/pages';

export const getStaticPaths = () => postStaticPaths('en');

const { post, translation, newer, older, routes } = Astro.props as PostProps;
---

<PostPage lang="en" post={post} translation={translation} newer={newer} older={older} routes={routes} />
