---
import BlogIndexPage from '@/views/BlogIndexPage.astro';
import { blogRoutes, tagStaticPaths } from '@/lib/pages';

export const getStaticPaths = () => tagStaticPaths('en', blogRoutes);

const { tag, routes } = Astro.props as { tag: string; routes: { zh: string; en: string } };
---

<BlogIndexPage lang="en" routes={routes} currentTag={tag} />
