---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
import SystemMessage from '@/components/SystemMessage.astro';
import EntryGate from '@/components/EntryGate.astro';
import T from '@/components/T.astro';
import { languages, type Lang } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';
import type { RoutePair } from '@/lib/routes';
import '@/styles/global.css';

interface Props {
  lang: Lang;
  copyrightOnly?: boolean;
  title?: string;
  description?: string;
  routes?: RoutePair;
  rssHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  lang,
  title,
  description = '',
  routes,
  rssHref,
  ogType,
  publishedTime,
  updatedTime,
  copyrightOnly = false,
} = Astro.props;

const pairs: RoutePair = routes ?? {
  zh: localizePath(Astro.url.pathname, 'zh'),
  en: localizePath(Astro.url.pathname, 'en'),
};

const rss = rssHref ?? (lang === 'zh' ? '/rss.xml' : '/en/rss.xml');
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-lang={lang}>
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={description}
      routes={pairs}
      rssHref={rss}
      ogType={ogType}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
    />
    <ClientRouter />
    {/* 首屏预判（内联、在 body 解析之前跑一次）：同一次访问的刷新 / 前进后退直接当"不用入场页"，
        免得为了它先画一帧入场页。判定故意比 visit-session 保守（只认"确实同一趟、确实已经进过站"），
        拿不准就什么都不写，交给 entry-gate.ts 按同一套规矩决定。 */}
    <script is:inline>
      try {
        var token = sessionStorage.getItem('rest-note.visit');
        var passed = sessionStorage.getItem('rest-note.entry-passed') === '1';
        var kind = (performance.getEntriesByType('navigation')[0] || {}).type || 'navigate';
        var entry = history.state && history.state.restNoteVisit;
        if (token && passed && entry === token && kind !== 'navigate') {
          document.documentElement.dataset.entry = 'open';
        }
      } catch (e) {
        /* 隐私模式 / 老浏览器：留给 JS 判定 */
      }
    </script>
  </head>

  <body class:list={{ 'copyright-only': copyrightOnly }}>
    {/* 背景渐变层。persist：客户端路由切换时保持同一个节点，背景不会闪。
        不用 body 背景图是因为它需要 fixed 定位才能让光晕不随滚动跑掉。 */}
    <div class="ambient" aria-hidden="true" transition:persist="ambient"></div>

    <EntryGate />

    <a class="skip-link" href="#main"><T k="a11y.skip" lang={lang} /></a>
    <Header lang={lang} routes={pairs} />
    <main id="main">
      <slot />
    </main>
    {copyrightOnly && <Footer lang={lang} routes={pairs} rssHref={rss} copyrightOnly />}

    {/* 解锁过隐藏曲目之后才会出现的小控制器，平时完全不存在 */}
    <ThemeSwitcher lang={lang} />

    <SystemMessage />

    <script>
      import '@/scripts/app.ts';
    </script>
  </body>
</html>
